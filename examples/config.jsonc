// Sample srt-agent global config: the baseline for EVERY agent and project.
// Copy to ~/.config/srt-agent/config.jsonc and adjust.
//
// Not here because the launcher sets them itself on every launch:
//   allowPty, allowAppleEvents, enableWeaker*, network.allowLocalBinding
//   (--allow-local-binding), and denyRead of / and your home folder.
{
  // Optional: import srt's own settings file as inherited defaults.
  // "baseSettings": "~/.srt-settings.json",
  "agentHome": "isolated",
  "notify": {"command": ["/usr/local/libexec/srt-agent-notify"]},
  "network": {
    "allowedDomains": [
      "github.com",
      "*.github.com",
      "*.githubusercontent.com",
      "api.github.com",
      "raw.githubusercontent.com",
      "registry.npmjs.org",
      "storage.googleapis.com",
      "formulae.brew.sh",
      // These give every project package downloads. Move them into the
      // python and rust groups to allow them per project instead.
      "pypi.org",
      "files.pythonhosted.org",
      "crates.io",
      "index.crates.io",
      "static.crates.io",
    ],
    "deniedDomains": [],
    "allowUnixSockets": [
      "/private/var/run/mDNSResponder",
    ],
    "allowMachLookup": [
      "com.apple.trustd.agent",  // TLS certificate checks (Rust, Go)
      "com.apple.pasteboard.1",  // clipboard: needed for pasting images into Claude
      "com.apple.dnssd.service",
      "com.apple.SystemConfiguration.DNSConfiguration",
      "com.apple.SystemConfiguration.configd",
    ],
  },
  "filesystem": {
    "allowRead": [
      // "/opt/homebrew/bin",
      // "/opt/homebrew/sbin",
      // "/opt/homebrew/Cellar",
      // "/opt/homebrew/Frameworks",
      // "/opt/homebrew/lib",
      // "/opt/homebrew/opt",
      // "/opt/homebrew/share",
      // "/opt/homebrew/etc/ca-certificates",
    ],
    "allowWrite": [
    ],
    "denyWrite": [
    ],
  },
  // A host-maintained, read-only venv for every project (see tools/update-tools).
  "toolsVenv": "~/.local/share/srt-agent/tools",
  "setEnv": {
    "DEVELOPER_DIR": "/Library/Developer/CommandLineTools",
  },
  "agents": {
    "claude": {
      "network": {
        "allowedDomains": [
          "api.anthropic.com",
          "mcp-proxy.anthropic.com",
          "claude.ai",
          "*.claude.ai",
          "claude.com",
          "*.claude.com",
        ],
      },
    },
    "codex": {
      "network": {
        "allowedDomains": [
          "chatgpt.com",
          "*.chatgpt.com",
          "openai.com",
          "*.openai.com",
          "*.oaistatic.com",
          "*.oaiusercontent.com",
        ],
      },
      "filesystem": {
        "allowRead": ["/opt/homebrew/Caskroom/codex"],
      },
    },
    "pi": {
      "setEnv": {
        "NODE_USE_ENV_PROXY": "1",
        "SSL_CERT_FILE": "/etc/ssl/cert.pem",
      },
    },
  },
  "groups": {
    "python": {
      "network": {
        "allowedDomains": [
          "pypi.org",
          "files.pythonhosted.org",
        ],
      },
    },
    "github": {
      "remove": {
        "network": {
          "allowedDomains": [
            "github.com",
            "api.github.com",
          ],
        },
      },
    },
  },
}
